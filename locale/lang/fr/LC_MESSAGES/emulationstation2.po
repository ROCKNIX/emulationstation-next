msgstr "RESTAURER LES PARAMÈTRES, PUIS REDÉMARRER ?\n\nVOTRE CONFIGURATION ACTUELLE EST REMPLACÉE. LES MOTS DE PASSE WI-FI ET DES COMPTES DEVRONT ÊTRE RESSAISIS."

msgid "YOUR SETTINGS WERE RESTORED.\n\nRESTORE YOUR SAVES, ROMS, BIOS, AND GAME CONTENT FROM THE CLOUD NOW?"
msgstr "VOS PARAMÈTRES ONT ÉTÉ RESTAURÉS.\n\nRESTAURER VOS SAUVEGARDES, VOS ROMS, VOS BIOS ET LE CONTENU DE VOS JEUX DEPUIS LE CLOUD MAINTENANT ?"

msgid "YOUR SETTINGS WERE RESTORED.\n\nRESTORE YOUR SAVES, ROMS, AND BIOS FROM THE CLOUD NOW?"
msgstr "VOS PARAMÈTRES ONT ÉTÉ RESTAURÉS.\n\nRESTAURER VOS SAUVEGARDES, VOS ROMS ET VOS BIOS DEPUIS LE CLOUD MAINTENANT ?"

msgid "YOUR SETTINGS WERE RESTORED.\n\nRESTORE YOUR SAVES AND GAME CONTENT FROM THE CLOUD NOW?"
msgstr "VOS PARAMÈTRES ONT ÉTÉ RESTAURÉS.\n\nRESTAURER VOS SAUVEGARDES ET LE CONTENU DE VOS JEUX DEPUIS LE CLOUD MAINTENANT ?"

msgid "YOUR SETTINGS WERE RESTORED.\n\nRESTORE YOUR ROMS, BIOS, AND GAME CONTENT FROM THE CLOUD NOW?"
msgstr "VOS PARAMÈTRES ONT ÉTÉ RESTAURÉS.\n\nRESTAURER VOS ROMS, VOS BIOS ET LE CONTENU DE VOS JEUX DEPUIS LE CLOUD MAINTENANT ?"

msgid "YOUR SETTINGS WERE RESTORED.\n\nRESTORE YOUR SAVES FROM THE CLOUD NOW?"
msgstr "VOS PARAMÈTRES ONT ÉTÉ RESTAURÉS.\n\nRESTAURER VOS SAUVEGARDES DEPUIS LE CLOUD MAINTENANT ?"

msgid "YOUR SETTINGS WERE RESTORED.\n\nRESTORE YOUR ROMS AND BIOS FROM THE CLOUD NOW?"
msgstr "VOS PARAMÈTRES ONT ÉTÉ RESTAURÉS.\n\nRESTAURER VOS ROMS ET VOS BIOS DEPUIS LE CLOUD MAINTENANT ?"

msgid "YOUR SETTINGS WERE RESTORED.\n\nRESTORE YOUR GAME CONTENT FROM THE CLOUD NOW?"
msgstr "VOS PARAMÈTRES ONT ÉTÉ RESTAURÉS.\n\nRESTAURER LE CONTENU DE VOS JEUX DEPUIS LE CLOUD MAINTENANT ?"

msgid "RECORDING YOUR LAST GAME'S SAVES..."
msgstr "ENREGISTREMENT DES SAUVEGARDES DE VOTRE DERNIÈRE PARTIE…"

msgid "YOUR SAVES ARE IN:"
msgstr "VOS SAUVEGARDES SONT DANS :"

msgid "YOUR PHONE BECOMES THE KEYBOARD. SCAN THE CODE, THEN CONTINUE."
msgstr "VOTRE TÉLÉPHONE DEVIENT LE CLAVIER. SCANNEZ LE CODE, PUIS CONTINUEZ."

msgid "YOUR SAVES ALREADY SYNC"
msgstr "VOS SAUVEGARDES SE SYNCHRONISENT DÉJÀ"

msgid "THIS DEVICE WAS SET TO SYNC THEM, SO FROM NOW ON THEY GO TO THIS CLOUD."
msgstr "CET APPAREIL ÉTAIT RÉGLÉ POUR LES SYNCHRONISER : DÉSORMAIS, ELLES VONT DANS CE CLOUD."

msgid "CONNECTING ONLY GIVES THIS DEVICE SOMEWHERE TO PUT THINGS. TO SYNC SAVES ON THEIR OWN, TURN IT ON UNDER MANAGE CLOUD STORAGE."
msgstr "SE CONNECTER NE FAIT QUE DONNER À CET APPAREIL UN ENDROIT OÙ RANGER LES CHOSES. POUR SYNCHRONISER LES SAUVEGARDES D’ELLES-MÊMES, ACTIVEZ-LE DANS GÉRER LE STOCKAGE CLOUD."

msgid "THE WI-FI SERVICE DIDN'T ANSWER. TRY AGAIN IN A MOMENT."
msgstr "LE SERVICE WI-FI N’A PAS RÉPONDU. RÉESSAYEZ DANS UN INSTANT."

msgid "SOME ACHIEVEMENT IMAGES COULDN'T BE SAVED. TRY THE SCAN AGAIN."
msgstr "CERTAINES IMAGES DE SUCCÈS N’ONT PAS PU ÊTRE ENREGISTRÉES. RELANCEZ L’ANALYSE."

msgid "SOME ACHIEVEMENT IMAGES COULDN'T BE SAVED"
msgstr "CERTAINES IMAGES DE SUCCÈS N’ONT PAS PU ÊTRE ENREGISTRÉES"

msgid "YOUR PROGRESS COULDN'T BE READ"
msgstr "VOTRE PROGRESSION N’A PAS PU ÊTRE LUE"

msgid "SOMETHING CHANGED SINCE YOU CHECKED"
msgstr "QUELQUE CHOSE A CHANGÉ DEPUIS VOTRE VÉRIFICATION"

msgid "COULDN'T RECORD WHICH CARD YOUR SAVES ARE ON"
