msgid "1 FILE WAS REMOVED FROM THIS DEVICE."
msgstr "1 FICHIER A ÉTÉ SUPPRIMÉ DE CET APPAREIL."

#, c-format
msgid "%d FILES WERE REMOVED FROM THIS DEVICE."
msgstr "%d FICHIERS ONT ÉTÉ SUPPRIMÉS DE CET APPAREIL."

msgid "TRY AGAIN: MATCH THIS DEVICE TO THE CLOUD"
msgstr "RÉESSAYEZ : ALIGNER CET APPAREIL SUR LE CLOUD"

msgid "COULDN'T SAVE WHAT YOU TICKED, SO NOTHING WAS RESTORED."
msgstr "IMPOSSIBLE D’ENREGISTRER CE QUE VOUS AVEZ COCHÉ, DONC RIEN N’A ÉTÉ RESTAURÉ."

msgid "YOUR LAST GAME'S SAVES ARE STILL BEING RECORDED. TRY AGAIN IN A MOMENT."
msgstr "LES SAUVEGARDES DE VOTRE DERNIÈRE PARTIE SONT ENCORE EN COURS D’ENREGISTREMENT. RÉESSAYEZ DANS UN INSTANT."

msgid "ROMS, BIOS, AND GAME CONTENT"
msgstr "ROMS, BIOS ET CONTENU DES JEUX"

msgid "RESTORING ROMS AND BIOS"
msgstr "RESTAURATION DES ROMS ET BIOS"

msgid "COULDN'T SAVE WHAT YOU TICKED, SO NOTHING WAS BACKED UP."
msgstr "IMPOSSIBLE D’ENREGISTRER CE QUE VOUS AVEZ COCHÉ, DONC RIEN N’A ÉTÉ SAUVEGARDÉ."

msgid "BIOS FILES"
msgstr "FICHIERS BIOS"

msgid "%s IS SAVED."
msgstr "%s EST ENREGISTRÉ."

msgid "CONNECT WITH ITS SAVED KEY, OR FORGET IT?"
msgstr "CONNECTER AVEC SA CLÉ ENREGISTRÉE, OU L’OUBLIER ?"
